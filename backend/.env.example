# EVShield Backend Environment Variables

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration (Prisma ORM)
# Note: Backend will automatically fallback to in-memory store if PostgreSQL is unavailable
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/evshield_db?schema=public"

# Simulated Charging Station Server
FAKE_SERVER_URL=http://127.0.0.1:8080

# Python Executable Path (Optional: auto-detected from root .venv or system PATH if unset)
# PYTHON_EXECUTABLE=.venv/Scripts/python.exe

# ML Inference Configuration
ML_INFERENCE_TIMEOUT_MS=15000
DEBUG_ML=false
