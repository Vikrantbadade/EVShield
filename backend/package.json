{
  "name": "evshield-backend",
  "version": "1.0.0",
  "description": "EVShield Backend API Foundation - Cyber-Attack Monitoring & Defense Platform",
  "main": "dist/server.js",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "evshield",
    "express",
    "typescript",
    "cybersecurity",
    "ddos",
    "prisma",
    "postgresql"
  ],
  "author": "EVShield Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@types/ws": "^8.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "ws": "^8.22.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.43",
    "prisma": "^5.19.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true
  }
}
